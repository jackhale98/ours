// Ours API Worker. See docs/SELF_HOSTING.md.
// The top level is for local development and tests. `env.production` is the
// live instance at api.ourplanner.app (deployed with `--env production`);
// self-hosters change its domain, origins and database id to their own.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ours-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Platform invocation logs would record request URLs (invite ids) and headers
  // (client IPs). Keep them off; the app logs route/status/latency itself.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    // Comma-separated origins of the web app allowed by CORS.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173",
    // open | invite_only | closed
    "ALLOW_SIGNUPS": "open",
    // Public URL of the web app (magic links) and the passkey relying party.
    "APP_URL": "http://localhost:5173/",
    "RP_ID": "localhost",
    "RP_NAME": "Ours",
    // 'log' sends nothing (development). Set 'resend' + EMAIL_FROM and the EMAIL_API_KEY secret in production.
    "EMAIL_PROVIDER": "log",
    "MAX_SPACES_PER_USER": "3",
    "MAX_DEVICES_PER_USER": "10",
    "MAX_SPACE_BYTES": "20971520",
    "MAX_PUSHES_PER_MINUTE": "120",
    "MAX_PUSHES_PER_HOUR": "60",
    // Key rotation (ADR 0013): "on" to allow changing keys. Off unless set.
    "ROTATION": "on",
    // Passkey unlock (ADR 0015): "on" to let passkeys unlock keys. Off unless set.
    "PASSKEY_UNLOCK": "on"
    // Web Push is off locally: VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are
    // secrets (docs/SELF_HOSTING.md); tests pass their own.
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ours",
      // Replace with your database id: `wrangler d1 create ours`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "env": {
    "production": {
      // Without this the Worker would be called "ours-api-production".
      "name": "ours-api",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "api.ourplanner.app", "custom_domain": true }],
      "observability": { "enabled": true, "logs": { "invocation_logs": false } },
      "vars": {
        "ALLOWED_ORIGINS": "https://ourplanner.app",
        // "open" until the first account exists: invite_only refuses anyone
        // without an invite, the very first person included.
        "ALLOW_SIGNUPS": "open",
        "APP_URL": "https://ourplanner.app/",
        "RP_ID": "ourplanner.app",
        "RP_NAME": "Ours",
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "Ours <hello@mail.ourplanner.app>",
        "MAX_SPACES_PER_USER": "3",
        "MAX_DEVICES_PER_USER": "10",
        "MAX_SPACE_BYTES": "20971520",
        "MAX_PUSHES_PER_MINUTE": "120",
        "MAX_PUSHES_PER_HOUR": "60",
        // Key rotation (ADR 0013), signed off in security review 0005.
        "ROTATION": "on",
        // Passkey unlock (ADR 0015), signed off in security review 0006.
        "PASSKEY_UNLOCK": "on"
        // VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are secrets here, made by the
        // "Create Worker secrets" workflow; a var of the same name would clash.
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ours",
          // "ours" in Eastern North America (location hint ENAM).
          "database_id": "aa4adb50-0f58-4b3d-b775-a0c35214552d",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
