// Ours API Worker. See docs/SELF_HOSTING.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ours-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    // Comma-separated origins of the web app allowed by CORS.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173",
    // open | invite_only | closed
    "ALLOW_SIGNUPS": "open",
    // Public URL of the web app (magic links) and the passkey relying party.
    "APP_URL": "http://localhost:5173/",
    "RP_ID": "localhost",
    "RP_NAME": "Ours",
    // 'log' sends nothing (development). Set 'resend' + EMAIL_FROM and the EMAIL_API_KEY secret in production.
    "EMAIL_PROVIDER": "log",
    "MAX_SPACES_PER_USER": "3",
    "MAX_DEVICES_PER_USER": "10",
    "MAX_SPACE_BYTES": "20971520",
    "MAX_PUSHES_PER_MINUTE": "120"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ours",
      // Replace with your database id: `wrangler d1 create ours`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
